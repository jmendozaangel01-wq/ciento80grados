# Copiar a .env y rellenar. El .env real esta en .gitignore.

# Google Analytics 4 — Administrador > Flujos de datos > tu flujo web.
# Dejar el placeholder desactiva GA4: el script no se carga y el banner de
# cookies sigue funcionando sin enviar nada.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# YouTube Data API — seccion de videos del home.
VITE_YOUTUBE_API_KEY=
VITE_YOUTUBE_CHANNEL_ID=

# Google API key usada por el panel de /dashboard.
VITE_GOOGLE_API_KEY=

# Webhook de n8n al que /dashboard envia eventos.
VITE_N8N_WEBHOOK_URL=
